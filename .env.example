# ก๊อปไฟล์นี้เป็น .env แล้วเติมค่าให้ครบ
# ไฟล์ .env ไม่ถูกอัปขึ้น GitHub (อยู่ใน .gitignore แล้ว)

# ได้จาก @BotFather ใน Telegram
BOT_TOKEN=

# เลข chat ของเจ้าของ — รันบอทครั้งแรกแล้วทักไป 1 ที เลขจะขึ้นในหน้าต่างดำ
CHAT_ID=

# เวลาส่งสรุป (เวลาไทย)
NIGHTLY_HOUR=0
MONTHLY_HOUR=9

# เป้าหมายจากชีตแผนการเงิน
TARGET_DAY=290
TARGET_WEEK=2030
TARGET_MONTH=8800

# ระบบการเงิน
KTB_FLOAT=1000
MONTHLY_TRANSFER=3828
MONTHLY_DCA=500

# งบใช้ส่วนตัวต่อเดือน (3,828 - ผ่อนมือถือ 748 - YouTube 80)
PERSONAL_BUDGET=3000

# วันแรกที่เริ่มเก็บข้อมูล
START_DATE=2026-09-15

# เรทที่ใช้ตีราคา Token ที่กองอยู่ในเกม (เรทที่ซื้อจากพ่อค้าได้)
STOCK_RATE=11
